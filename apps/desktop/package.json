{
  "name": "@alma/desktop",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "vitest run",
    "test:native": "node scripts/run-native-tests.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "e2e": "electron-vite build && playwright test",
    "postinstall": "node scripts/postinstall.mjs",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist:win": "bash scripts/dist-win.sh",
    "db:generate": "drizzle-kit generate",
    "dist:mac": "electron-vite build && electron-builder --mac"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "node-pty": "1.1.0",
    "ssh-config": "5.3.0",
    "ssh2": "1.17.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@electron/rebuild": "4.2.1",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@playwright/test": "1.64.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ssh2": "1.15.6",
    "@vitejs/plugin-react": "5.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "axe-core": "4.13.0",
    "cmdk": "1.1.1",
    "drizzle-kit": "0.31.11",
    "electron": "44.5.1",
    "electron-builder": "26.16.1",
    "electron-vite": "5.0.0",
    "jsdom": "30.1.2",
    "lucide-react": "1.56.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "7.3.7",
    "vitest": "5.0.4",
    "zustand": "5.0.15"
  },
  "description": "Desktop SSH client with terminal, SFTP and split panes",
  "author": "John Madrigal",
  "homepage": "https://github.com/johnmadrigal5-droid/alma-term"
}
